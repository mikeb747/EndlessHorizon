<workout_file>
    <author></author>
    <name>Endurance #3</name>
    <description>Endurance sessions are the ideal time to focus on improving your pedaling. Power is not the focus in this session. Throughout today&apos;s endurance ride we will be increasing the focus on your cardiovascular endurance, by challenging your ability to pedal at a high cadence. A fun session that includes a range of high RPM intervals.</description>
    <sportType>bike</sportType>
	<category>TTTuneUp</category>
    <tags>
        <tag name="TTTuneUp"/>
    </tags>
    <workout>
        <Warmup Duration="180" PowerLow="0.45" PowerHigh="0.6"/>
        <SteadyState Duration="60" Power="0.6"/>
        <SteadyState Duration="60" Power="0.65"/>
        <SteadyState Duration="60" Power="0.81"/>
        <SteadyState Duration="60" Power="1.09"/>
        <SteadyState Duration="120" Power="0.5"/>
        <SteadyState Duration="180" Power="0.9"/>
        <SteadyState Duration="180" Power="0.5"/>
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="60" OnPower="0.85" OffPower="0.5" Cadence="110" CadenceResting="85">
            <textevent timeoffset="0" message="110rpm"/>
            <textevent timeoffset="60" message="85rpm"/>
        </IntervalsT>
        <Ramp Duration="300" PowerLow="0.6" PowerHigh="0.75"/>
        <SteadyState Duration="20" Power="1.1"/>
        <Ramp Duration="300" PowerLow="0.75" PowerHigh="0.6"/>
        <IntervalsT Repeat="2" OnDuration="300" OffDuration="300" OnPower="0.9" OffPower="0.6" Cadence="100" CadenceResting="90">
            <textevent timeoffset="0" message="100rpm"/>
            <textevent timeoffset="300" message="90rpm"/>
        </IntervalsT>
        <IntervalsT Repeat="2" OnDuration="60" OffDuration="60" OnPower="0.85" OffPower="0.5" Cadence="110" CadenceResting="85">
            <textevent timeoffset="0" message="110rpm"/>
            <textevent timeoffset="60" message="85rpm"/>
        </IntervalsT>
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.45"/>
    </workout>
</workout_file>
                                    