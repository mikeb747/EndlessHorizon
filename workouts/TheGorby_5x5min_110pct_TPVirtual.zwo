<workout_file>
  <author>Mike – The Gorby</author>
  <name>The Gorby – 5x5 @110% FTP</name>
  <description>5 x 5:00 @ 352W (110% FTP) with 5:00 recoveries</description>
  <sportType>bike</sportType>
  <tags>
    <tag name="VO2Max"/>
    <tag name="ClassicZwift"/>
  </tags>

  <workout>
    <!-- Warm-up: 10 min ramp from 30% to 80% FTP -->
    <Warmup Duration="600" PowerLow="0.30" PowerHigh="0.80"/>

    <!-- Main set: 5 x (5:00 hard, 5:00 easy) -->
    <SteadyState Duration="300" Power="1.10"/>
    <SteadyState Duration="300" Power="0.55"/>

    <SteadyState Duration="300" Power="1.10"/>
    <SteadyState Duration="300" Power="0.55"/>

    <SteadyState Duration="300" Power="1.10"/>
    <SteadyState Duration="300" Power="0.55"/>

    <SteadyState Duration="300" Power="1.10"/>
    <SteadyState Duration="300" Power="0.55"/>

    <SteadyState Duration="300" Power="1.10"/>
    <SteadyState Duration="300" Power="0.55"/>

    <!-- Cool-down: 5 min from 60% to 40% FTP -->
    <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
