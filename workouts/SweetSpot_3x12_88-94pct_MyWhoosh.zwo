<workout_file>
  <author>Mike – Sweet Spot Progression</author>
  <name>Sweet Spot 3x12 @88–94% FTP</name>
  <description>3 x 12 min Sweet Spot @ 282–301W with 5 min recoveries</description>
  <sportType>bike</sportType>
  <tags>
    <tag name="SweetSpot"/>
    <tag name="Endurance"/>
  </tags>

  <workout>
    <!-- Warm-up: 15 min progressive with spin-ups -->
    <SteadyState Duration="300" Power="0.50" Cadence="92"/>
    <SteadyState Duration="300" Power="0.73" Cadence="90"/>
    <SteadyState Duration="30" Power="0.90" Cadence="102"/>
    <SteadyState Duration="30" Power="0.50" Cadence="85"/>
    <SteadyState Duration="30" Power="0.90" Cadence="102"/>
    <SteadyState Duration="30" Power="0.50" Cadence="85"/>
    <SteadyState Duration="30" Power="0.90" Cadence="102"/>
    <SteadyState Duration="120" Power="0.75" Cadence="90"/>

    <!-- Main set: 3 x 12 min @ 88–94% FTP -->
    <SteadyState Duration="720" Power="0.91" Cadence="90"/>
    <SteadyState Duration="300" Power="0.50" Cadence="85"/>

    <SteadyState Duration="720" Power="0.91" Cadence="90"/>
    <SteadyState Duration="300" Power="0.50" Cadence="85"/>

    <SteadyState Duration="720" Power="0.91" Cadence="90"/>

    <!-- Cool-down: 10 min -->
    <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
