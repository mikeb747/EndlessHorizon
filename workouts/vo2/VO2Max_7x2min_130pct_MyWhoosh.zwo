<workout_file>
  <author>Mike – VO2 Max 7x2min</author>
  <name>VO2 Max 7x2 @130% FTP</name>
  <description>7 x 2:00 @ 416W (130% FTP) with 3:00 recoveries</description>
  <sportType>bike</sportType>
  <tags>
    <tag name="VO2Max"/>
    <tag name="HighIntensity"/>
  </tags>

  <workout>
    <!-- Warm-up: 15 min progressive with spin-ups -->
    <SteadyState Duration="300" Power="0.50" Cadence="92"/>
    <SteadyState Duration="300" Power="0.73" Cadence="90"/>
    <SteadyState Duration="30" Power="1.00" Cadence="102"/>
    <SteadyState Duration="30" Power="0.50" Cadence="85"/>
    <SteadyState Duration="30" Power="1.00" Cadence="102"/>
    <SteadyState Duration="30" Power="0.50" Cadence="85"/>
    <SteadyState Duration="30" Power="1.00" Cadence="102"/>
    <SteadyState Duration="120" Power="0.75" Cadence="90"/>

    <!-- Main set: 7 x (2:00 hard, 3:00 easy) -->
    <SteadyState Duration="120" Power="1.30" Cadence="95"/>
    <SteadyState Duration="180" Power="0.50" Cadence="85"/>

    <SteadyState Duration="120" Power="1.30" Cadence="95"/>
    <SteadyState Duration="180" Power="0.50" Cadence="85"/>

    <SteadyState Duration="120" Power="1.30" Cadence="95"/>
    <SteadyState Duration="180" Power="0.50" Cadence="85"/>

    <SteadyState Duration="120" Power="1.30" Cadence="95"/>
    <SteadyState Duration="180" Power="0.50" Cadence="85"/>

    <SteadyState Duration="120" Power="1.30" Cadence="95"/>
    <SteadyState Duration="180" Power="0.50" Cadence="85"/>

    <SteadyState Duration="120" Power="1.30" Cadence="95"/>
    <SteadyState Duration="180" Power="0.50" Cadence="85"/>

    <SteadyState Duration="120" Power="1.30" Cadence="95"/>

    <!-- Cool-down: 10 min -->
    <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
