<workout_file>
    <author></author>
    <name>Tempo 15min / Target rpm #3</name>
    <description>Tempo riding is a great way to improve your aerobic efficiency. Today&apos;s session consists of long tempo efforts. However, to focus more on muscular endurance, the target cadence starts at 75rpm and increases by 5rpm every 5min</description>
    <sportType>bike</sportType>
	<category>TTTuneUp</category>
    <tags>
        <tag name="TTTuneUp"/>
    </tags>
    <workout>
        <Warmup Duration="180" PowerLow="0.45" PowerHigh="0.6"/>
        <SteadyState Duration="60" Power="0.6"/>
        <SteadyState Duration="60" Power="0.65"/>
        <SteadyState Duration="60" Power="0.81"/>
        <SteadyState Duration="60" Power="1.09"/>
        <SteadyState Duration="120" Power="0.5"/>
        <SteadyState Duration="180" Power="0.9"/>
        <SteadyState Duration="180" Power="0.5"/>
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" Cadence="75">
            <textevent timeoffset="0" message="75rpm"/>
        </Ramp>
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" Cadence="80">
            <textevent timeoffset="0" message="80rpm"/>
        </Ramp>
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" Cadence="90">
            <textevent timeoffset="0" message="90rpm"/>
        </Ramp>
        <SteadyState Duration="120" Power="0.5"/>
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" Cadence="75">
            <textevent timeoffset="0" message="75rpm"/>
        </Ramp>
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" Cadence="80">
            <textevent timeoffset="0" message="80rpm"/>
        </Ramp>
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" Cadence="90">
            <textevent timeoffset="0" message="90rpm"/>
        </Ramp>
        <SteadyState Duration="120" Power="0.5"/>
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" Cadence="75">
            <textevent timeoffset="0" message="75rpm"/>
        </Ramp>
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" Cadence="80">
            <textevent timeoffset="0" message="80rpm"/>
        </Ramp>
        <Ramp Duration="300" PowerLow="0.76" PowerHigh="0.89" Cadence="90">
            <textevent timeoffset="0" message="90rpm"/>
        </Ramp>
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.45"/>
    </workout>
</workout_file>
                                                 